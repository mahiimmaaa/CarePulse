# ==========================================
# ChatGPT / OpenAI Setup (Recommended for ChatGPT users)
# ==========================================
# Add your OpenAI / ChatGPT API Key starting with sk-...
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_API_KEY_HERE"

# Optional: OpenAI model (defaults to gpt-4o-mini if not specified)
# Supported options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
OPENAI_MODEL="gpt-4o-mini"

# ==========================================
# Alternative: Dify API Setup (if using Dify)
# ==========================================
CHAT_API_URL="https://api.dify.ai/v1"
CHAT_API_KEY="app-YOUR_DIFY_API_KEY_HERE"

# ==========================================
# Optional Server Settings
# ==========================================
PORT=3000
