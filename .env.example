# GEMINI_API_KEY: Optional fallback for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CHAT_API_URL: Base URL of the chatbot backend (e.g. Dify API)
CHAT_API_URL="https://api.dify.ai/v1"

# CHAT_API_KEY: Secret API key for the chatbot backend (kept strictly server-side)
CHAT_API_KEY="app-pszv9m8ElDoTtnrUWkFeXLHw"
